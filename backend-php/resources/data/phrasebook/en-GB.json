[{"id":"greetings","level":"A1","situation":"Greetings & Introductions","icon":"👋","phrases":[{"text":"Hello!","context":"Standard neutral greeting","register":"neutral","unit_ref":null,"romanization":null},{"text":"Hi!","context":"Informal greeting between friends or peers","register":"informal","unit_ref":null,"romanization":null},{"text":"Good morning.","context":"Greeting before noon","register":"formal","unit_ref":null,"romanization":null},{"text":"Good afternoon.","context":"Greeting between noon and 6 pm","register":"formal","unit_ref":null,"romanization":null},{"text":"Good evening.","context":"Greeting after 6 pm","register":"formal","unit_ref":null,"romanization":null},{"text":"How are you?","context":"Asking about well-being","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm fine, thank you. And you?","context":"Polite reply to \"How are you?\"","register":"neutral","unit_ref":null,"romanization":null},{"text":"Nice to meet you.","context":"First meeting","register":"neutral","unit_ref":null,"romanization":null},{"text":"Nice to meet you too.","context":"Replying to \"Nice to meet you\"","register":"neutral","unit_ref":null,"romanization":null},{"text":"My name is [Name].","context":"Introducing yourself","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm from [Country].","context":"Saying where you are from","register":"neutral","unit_ref":null,"romanization":null},{"text":"See you later!","context":"Informal farewell","register":"informal","unit_ref":null,"romanization":null},{"text":"Goodbye!","context":"Standard farewell — suitable in all contexts","register":"neutral","unit_ref":null,"romanization":null},{"text":"Bye! / Bye-bye!","context":"Informal farewell","register":"informal","unit_ref":null,"romanization":null},{"text":"Take care!","context":"Warm farewell","register":"neutral","unit_ref":null,"romanization":null},{"text":"Have a lovely day!","context":"Polite British farewell","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"basic_requests","level":"A1","situation":"Basic Requests & Polite Phrases","icon":"🙏","phrases":[{"text":"Can you help me, please?","context":"Asking for assistance","register":"neutral","unit_ref":null,"romanization":null},{"text":"Could you repeat that, please?","context":"When you didn't understand","register":"neutral","unit_ref":null,"romanization":null},{"text":"I don't understand.","context":"Saying you don't understand","register":"neutral","unit_ref":null,"romanization":null},{"text":"Can you speak more slowly, please?","context":"When someone speaks too fast","register":"neutral","unit_ref":null,"romanization":null},{"text":"How do you say [word] in English?","context":"Asking for a translation","register":"neutral","unit_ref":null,"romanization":null},{"text":"What does [word] mean?","context":"Asking for a definition","register":"neutral","unit_ref":null,"romanization":null},{"text":"Sorry, I don't know.","context":"Saying you don't know something","register":"neutral","unit_ref":null,"romanization":null},{"text":"Excuse me.","context":"Getting someone's attention","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm sorry.","context":"Apologising","register":"neutral","unit_ref":null,"romanization":null},{"text":"That's OK. / No problem.","context":"Accepting an apology","register":"neutral","unit_ref":null,"romanization":null},{"text":"Thank you very much.","context":"Expressing strong gratitude","register":"neutral","unit_ref":null,"romanization":null},{"text":"You're welcome.","context":"Responding to thanks (neutral)","register":"neutral","unit_ref":null,"romanization":null},{"text":"Not at all.","context":"British alternative to 'You're welcome' — slightly more formal","register":"neutral","unit_ref":null,"romanization":null},{"text":"My pleasure.","context":"Warm British response to thanks","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"numbers_time_a1","level":"A1","situation":"Numbers & Telling the Time","icon":"🕒","phrases":[{"text":"What time is it?","context":"Asking for the time","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's [time] o'clock.","context":"Telling the time on the hour","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's half past [hour].","context":"Telling the time at :30","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's quarter past [hour].","context":"Telling the time at :15","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's quarter to [hour].","context":"Telling the time at :45","register":"neutral","unit_ref":null,"romanization":null},{"text":"The meeting is at [time].","context":"Stating a scheduled time","register":"neutral","unit_ref":null,"romanization":null},{"text":"How much is it?","context":"Asking the price","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's [price] pounds.","context":"Stating a price in British currency","register":"neutral","unit_ref":null,"romanization":null},{"text":"Can I have the bill, please?","context":"Asking for the bill at a café","register":"neutral","unit_ref":null,"romanization":null},{"text":"What's the date today?","context":"Asking for the current date","register":"neutral","unit_ref":null,"romanization":null},{"text":"My birthday is on [date].","context":"Stating a date","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"shopping_basic_a1","level":"A1","situation":"Shopping (Basics)","icon":"🛍️","phrases":[{"text":"I'd like [item], please.","context":"Ordering or buying something","register":"neutral","unit_ref":null,"romanization":null},{"text":"How much does this cost?","context":"Asking the price","register":"neutral","unit_ref":null,"romanization":null},{"text":"Do you have this in [size/colour]?","context":"Asking about stock","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'll take it.","context":"Deciding to buy something","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm just looking, thank you.","context":"Telling a shop assistant you're browsing","register":"neutral","unit_ref":null,"romanization":null},{"text":"Can I try this on?","context":"Asking to try on clothes","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's too big / small / expensive.","context":"Explaining a problem","register":"neutral","unit_ref":null,"romanization":null},{"text":"Can I pay by card?","context":"Asking about payment methods","register":"neutral","unit_ref":null,"romanization":null},{"text":"Can I have a bag, please?","context":"Asking for a shopping bag","register":"neutral","unit_ref":null,"romanization":null},{"text":"Could I have a receipt?","context":"Asking for a receipt","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"asking_directions_a1","level":"A1","situation":"Asking for Directions","icon":"🗺️","phrases":[{"text":"Excuse me, where is [place]?","context":"Asking for a location","register":"neutral","unit_ref":null,"romanization":null},{"text":"How do I get to [place]?","context":"Asking for directions","register":"neutral","unit_ref":null,"romanization":null},{"text":"Is it far from here?","context":"Asking about distance","register":"neutral","unit_ref":null,"romanization":null},{"text":"Turn left / right.","context":"Giving a direction","register":"neutral","unit_ref":null,"romanization":null},{"text":"Go straight ahead.","context":"Giving a direction","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's on the left / right.","context":"Describing a location","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's next to / opposite [landmark].","context":"Describing a location","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's about [number] minutes on foot.","context":"Describing distance","register":"neutral","unit_ref":null,"romanization":null},{"text":"Take the [number] bus.","context":"Giving transport advice","register":"neutral","unit_ref":null,"romanization":null},{"text":"Sorry, I don't know this area.","context":"Unable to help","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"restaurant_a2","level":"A2","situation":"At a Restaurant","icon":"🍽️","phrases":[{"text":"A table for two, please.","context":"Arriving at a restaurant","register":"neutral","unit_ref":null,"romanization":null},{"text":"Can I see the menu, please?","context":"Asking for the menu","register":"neutral","unit_ref":null,"romanization":null},{"text":"What do you recommend?","context":"Asking the waiter for advice","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'll have [dish], please.","context":"Ordering food","register":"neutral","unit_ref":null,"romanization":null},{"text":"Could I have [dish] instead of [dish]?","context":"Changing your order","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm allergic to [ingredient].","context":"Informing about allergies","register":"neutral","unit_ref":null,"romanization":null},{"text":"Is [dish] vegetarian / vegan?","context":"Asking about dietary options","register":"neutral","unit_ref":null,"romanization":null},{"text":"Excuse me, we've been waiting for a while.","context":"Polite complaint","register":"neutral","unit_ref":null,"romanization":null},{"text":"The food is delicious!","context":"Complimenting the food","register":"neutral","unit_ref":null,"romanization":null},{"text":"Could we have the bill, please?","context":"Asking for the bill","register":"neutral","unit_ref":null,"romanization":null},{"text":"Do you accept credit cards?","context":"Asking about payment","register":"neutral","unit_ref":null,"romanization":null},{"text":"Could we split the bill?","context":"Paying separately","register":"neutral","unit_ref":null,"romanization":null},{"text":"Could I have some tap water, please?","context":"Requesting free tap water — licensed premises in the UK are legally required to provide it","register":"neutral","unit_ref":null,"romanization":null},{"text":"Is service included?","context":"Asking about the tip","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"transport_booking_a2","level":"A2","situation":"Travel & Transport","icon":"🚆","phrases":[{"text":"One ticket to [destination], please.","context":"Buying a ticket","register":"neutral","unit_ref":null,"romanization":null},{"text":"A return ticket to [destination], please.","context":"Buying a return ticket","register":"neutral","unit_ref":null,"romanization":null},{"text":"What time does the next train leave?","context":"Asking about departure times","register":"neutral","unit_ref":null,"romanization":null},{"text":"Which platform does it leave from?","context":"Asking about the platform","register":"neutral","unit_ref":null,"romanization":null},{"text":"Is there a direct train to [destination]?","context":"Asking about connections","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'd like to book a seat.","context":"Reserving a seat","register":"neutral","unit_ref":null,"romanization":null},{"text":"I've missed my train / flight.","context":"Explaining a missed connection","register":"neutral","unit_ref":null,"romanization":null},{"text":"Is there a delay?","context":"Asking about delays","register":"neutral","unit_ref":null,"romanization":null},{"text":"Where is gate [number]?","context":"At an airport","register":"neutral","unit_ref":null,"romanization":null},{"text":"I have a connecting flight at [time].","context":"Informing about a connection","register":"neutral","unit_ref":null,"romanization":null},{"text":"Is there a tourist pass available?","context":"Asking about city transport","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"weather_talk_a2","level":"A2","situation":"Talking About Weather","icon":"🌤️","phrases":[{"text":"What's the weather like today?","context":"Asking about current weather","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's sunny / cloudy / rainy.","context":"Describing current weather","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's quite warm / cold today.","context":"Describing temperature","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's going to rain later.","context":"Predicting weather","register":"neutral","unit_ref":null,"romanization":null},{"text":"What's the forecast for tomorrow?","context":"Asking about tomorrow's weather","register":"neutral","unit_ref":null,"romanization":null},{"text":"I love this kind of weather.","context":"Expressing preference","register":"informal","unit_ref":null,"romanization":null},{"text":"I hate it when it's this cold!","context":"Expressing dislike","register":"informal","unit_ref":null,"romanization":null},{"text":"You should bring an umbrella.","context":"Giving weather advice","register":"neutral","unit_ref":null,"romanization":null},{"text":"The weather is much better than yesterday.","context":"Comparing weather","register":"neutral","unit_ref":null,"romanization":null},{"text":"There's a chance of [rain/snow] later.","context":"Talking about weather forecast","register":"neutral","unit_ref":null,"romanization":null},{"text":"The forecast says it'll clear up by [time].","context":"Discussing weather forecast","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"making_plans_a2","level":"A2","situation":"Making Plans & Arrangements","icon":"📅","phrases":[{"text":"What are you doing this weekend?","context":"Asking about plans","register":"informal","unit_ref":null,"romanization":null},{"text":"Would you like to [do something]?","context":"Inviting someone","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'd love to!","context":"Accepting an invitation","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm afraid I can't. I have other plans.","context":"Declining an invitation","register":"neutral","unit_ref":null,"romanization":null},{"text":"Maybe another time.","context":"Polite decline","register":"neutral","unit_ref":null,"romanization":null},{"text":"What time shall we meet?","context":"Arranging a meeting time","register":"neutral","unit_ref":null,"romanization":null},{"text":"Let's meet at [time] at [place].","context":"Confirming arrangements","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'll be there at [time].","context":"Confirming attendance","register":"neutral","unit_ref":null,"romanization":null},{"text":"Can we change the time / date?","context":"Requesting a change","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm running late.","context":"Warning you will be late","register":"informal","unit_ref":null,"romanization":null},{"text":"I'll be there in about 10 minutes.","context":"Estimating your arrival time","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"feelings_a2","level":"A2","situation":"Expressing Feelings","icon":"😊","phrases":[{"text":"I'm really excited about [it].","context":"Showing enthusiasm","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm a bit nervous.","context":"Expressing nervousness","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm so tired.","context":"Expressing fatigue","register":"informal","unit_ref":null,"romanization":null},{"text":"That's great news!","context":"Reacting positively to news","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm sorry to hear that.","context":"Expressing sympathy","register":"neutral","unit_ref":null,"romanization":null},{"text":"Are you OK?","context":"Checking if someone is alright","register":"neutral","unit_ref":null,"romanization":null},{"text":"Don't worry about it.","context":"Reassuring someone","register":"informal","unit_ref":null,"romanization":null},{"text":"I'm not feeling well.","context":"Saying you feel ill","register":"neutral","unit_ref":null,"romanization":null},{"text":"I feel much better now.","context":"Saying your health improved","register":"neutral","unit_ref":null,"romanization":null},{"text":"I can't wait for [event]!","context":"Expressing anticipation","register":"informal","unit_ref":null,"romanization":null},{"text":"What a shame! / What a pity!","context":"Expressing disappointment","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"phone_calls_b1","level":"B1","situation":"Phone Calls","icon":"📞","phrases":[{"text":"Hello, this is [Name] speaking.","context":"Introducing yourself on the phone","register":"formal","unit_ref":null,"romanization":null},{"text":"Could I speak to [Name], please?","context":"Asking to speak to someone","register":"formal","unit_ref":null,"romanization":null},{"text":"I'm afraid [Name] isn't available.","context":"Saying someone isn't there","register":"formal","unit_ref":null,"romanization":null},{"text":"Can I take a message?","context":"Offering to take a message","register":"formal","unit_ref":null,"romanization":null},{"text":"Could you ask [Name] to call me back?","context":"Leaving a message","register":"formal","unit_ref":null,"romanization":null},{"text":"I'll call back later.","context":"Saying you'll call again","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm calling about [topic].","context":"Stating the reason for your call","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm sorry, you're breaking up.","context":"Poor signal","register":"neutral","unit_ref":null,"romanization":null},{"text":"Could you speak up, please?","context":"Asking someone to speak louder","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'll put you on hold for a moment.","context":"Asking someone to wait","register":"formal","unit_ref":null,"romanization":null},{"text":"Thank you for calling. Goodbye.","context":"Ending a professional call","register":"formal","unit_ref":null,"romanization":null}]},{"id":"job_interview_b1","level":"B1","situation":"Job Interviews","icon":"💼","phrases":[{"text":"Thank you for the opportunity.","context":"Thanking the interviewer","register":"formal","unit_ref":null,"romanization":null},{"text":"I'm very interested in this position.","context":"Expressing interest","register":"formal","unit_ref":null,"romanization":null},{"text":"In my previous role, I was responsible for...","context":"Describing past experience","register":"formal","unit_ref":null,"romanization":null},{"text":"I have experience in [field/skill].","context":"Mentioning a skill","register":"formal","unit_ref":null,"romanization":null},{"text":"My greatest strength is [strength].","context":"Answering a strengths question","register":"formal","unit_ref":null,"romanization":null},{"text":"I am a team player and also enjoy working independently.","context":"Describing work style","register":"formal","unit_ref":null,"romanization":null},{"text":"I'm a quick learner.","context":"Describing learning ability","register":"formal","unit_ref":null,"romanization":null},{"text":"What does a typical day look like in this role?","context":"Asking about the job","register":"formal","unit_ref":null,"romanization":null},{"text":"When can I expect to hear from you?","context":"Asking about next steps","register":"formal","unit_ref":null,"romanization":null},{"text":"I look forward to hearing from you.","context":"Closing the conversation","register":"formal","unit_ref":null,"romanization":null}]},{"id":"giving_opinions_b1","level":"B1","situation":"Giving Opinions & Agreeing/Disagreeing","icon":"💬","phrases":[{"text":"In my opinion, ...","context":"Introducing your view","register":"neutral","unit_ref":null,"romanization":null},{"text":"Personally, I think that...","context":"Emphasising a personal view","register":"neutral","unit_ref":null,"romanization":null},{"text":"I agree with you completely.","context":"Full agreement","register":"neutral","unit_ref":null,"romanization":null},{"text":"I partially agree, but...","context":"Partial agreement","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm afraid I don't agree.","context":"Polite disagreement","register":"neutral","unit_ref":null,"romanization":null},{"text":"That's a good point, but...","context":"Acknowledging then disagreeing","register":"neutral","unit_ref":null,"romanization":null},{"text":"I see your point, however...","context":"Countering an argument","register":"neutral","unit_ref":null,"romanization":null},{"text":"It depends on...","context":"Qualified answer","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm not sure about that.","context":"Expressing doubt","register":"neutral","unit_ref":null,"romanization":null},{"text":"Could you clarify what you mean?","context":"Asking for clarification","register":"neutral","unit_ref":null,"romanization":null},{"text":"As far as I know, ...","context":"Limited certainty","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'd like to add that...","context":"Adding to the conversation","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"health_appointments_b1","level":"B1","situation":"Health & Doctor Appointments","icon":"🏥","phrases":[{"text":"I'd like to make an appointment.","context":"Booking a medical appointment","register":"formal","unit_ref":null,"romanization":null},{"text":"I haven't been feeling well lately.","context":"Describing general illness","register":"neutral","unit_ref":null,"romanization":null},{"text":"I have a pain in my [body part].","context":"Describing pain location","register":"neutral","unit_ref":null,"romanization":null},{"text":"The pain started [time] ago.","context":"Describing when symptoms began","register":"neutral","unit_ref":null,"romanization":null},{"text":"I have a temperature of [degrees].","context":"Reporting a fever","register":"neutral","unit_ref":null,"romanization":null},{"text":"I've been having trouble sleeping.","context":"Reporting sleep problems","register":"neutral","unit_ref":null,"romanization":null},{"text":"What would you suggest for this?","context":"Asking the doctor for a treatment recommendation (distinct from restaurant 'What do you recommend?')","register":"neutral","unit_ref":null,"romanization":null},{"text":"Do I need a prescription?","context":"Asking about medication","register":"neutral","unit_ref":null,"romanization":null},{"text":"How often should I take this?","context":"Asking about dosage","register":"neutral","unit_ref":null,"romanization":null},{"text":"When should I come back?","context":"Asking about follow-up","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'd like to register with a GP, please.","context":"Registering with a doctor at an NHS surgery for the first time","register":"formal","unit_ref":null,"romanization":null},{"text":"I need to make an appointment at the surgery.","context":"Booking a GP appointment — 'surgery' is the British term for a GP's clinic","register":"neutral","unit_ref":null,"romanization":null},{"text":"Should I call NHS 111?","context":"Asking whether to use the NHS non-emergency helpline (available 24/7 in the UK)","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"pub_social_b1","level":"B1","situation":"British Pub & Social Life","icon":"🍺","phrases":[{"text":"What are you having?","context":"Asking someone what they want to drink — essential for buying a round","register":"informal","unit_ref":null,"romanization":null},{"text":"It's my round.","context":"Saying it is your turn to buy drinks for the group. Buying rounds is a core British social custom.","register":"informal","unit_ref":null,"romanization":null},{"text":"Same again?","context":"Asking if someone wants the same drink as before","register":"informal","unit_ref":null,"romanization":null},{"text":"Cheers!","context":"Toast used when drinking; also a casual way to say thank you","register":"informal","unit_ref":null,"romanization":null},{"text":"A pint of [lager/bitter/ale], please.","context":"Ordering beer measured in pints (568ml). A pint is the standard British beer measure.","register":"neutral","unit_ref":null,"romanization":null},{"text":"This round's on me.","context":"Telling the group you will pay for everyone's drinks","register":"informal","unit_ref":null,"romanization":null},{"text":"Shall we head to the pub?","context":"Suggesting going to a pub — the British pub is a central social institution","register":"informal","unit_ref":null,"romanization":null},{"text":"Are you alright for drinks?","context":"Checking if anyone in the group needs another drink","register":"informal","unit_ref":null,"romanization":null},{"text":"Last orders, please!","context":"The barman's announcement that the bar is about to stop serving — you must order your final drinks","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'll get these.","context":"Saying you will pay for the current round or items","register":"informal","unit_ref":null,"romanization":null}]},{"id":"formal_emails_b2","level":"B2","situation":"Formal Emails & Letters","icon":"📧","phrases":[{"text":"I am writing to enquire about...","context":"Opening — asking for information","register":"formal","unit_ref":null,"romanization":null},{"text":"I am writing with reference to...","context":"Opening — referencing something","register":"formal","unit_ref":null,"romanization":null},{"text":"Thank you for your email of [date].","context":"Acknowledging a received email","register":"formal","unit_ref":null,"romanization":null},{"text":"Further to our conversation, ...","context":"Following up after a meeting/call","register":"formal","unit_ref":null,"romanization":null},{"text":"Please note that...","context":"Drawing attention to important information in a formal email — common in British business correspondence","register":"formal","unit_ref":null,"romanization":null},{"text":"Please find attached [document].","context":"Mentioning an attachment","register":"formal","unit_ref":null,"romanization":null},{"text":"I would appreciate it if you could...","context":"Making a formal request","register":"formal","unit_ref":null,"romanization":null},{"text":"Should you require any further information, please do not hesitate to contact me.","context":"Offering further help","register":"formal","unit_ref":null,"romanization":null},{"text":"I look forward to your reply.","context":"Closing — awaiting response","register":"formal","unit_ref":null,"romanization":null},{"text":"Yours faithfully,","context":"Formal sign-off when the salutation is 'Dear Sir/Madam' (recipient unknown)","register":"formal","unit_ref":null,"romanization":null},{"text":"Yours sincerely,","context":"Formal sign-off when the salutation names the recipient (e.g. 'Dear Mr Smith')","register":"formal","unit_ref":null,"romanization":null},{"text":"Kind regards, / Best regards,","context":"Semi-formal sign-off","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"negotiations_b2","level":"B2","situation":"Discussions & Negotiations","icon":"🤝","phrases":[{"text":"Could we come to a compromise?","context":"Proposing a middle ground","register":"formal","unit_ref":null,"romanization":null},{"text":"I see your point, but from our perspective...","context":"Presenting your side","register":"neutral","unit_ref":null,"romanization":null},{"text":"We'd be willing to [offer], provided that...","context":"Making a conditional offer","register":"formal","unit_ref":null,"romanization":null},{"text":"That doesn't quite work for us because...","context":"Politely rejecting a proposal","register":"neutral","unit_ref":null,"romanization":null},{"text":"What if we were to [suggest alternative]?","context":"Proposing an alternative","register":"neutral","unit_ref":null,"romanization":null},{"text":"We need to consider all the options.","context":"Stalling for time","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'll need to discuss this with my team.","context":"Deferring a decision","register":"neutral","unit_ref":null,"romanization":null},{"text":"Can we revisit this point later?","context":"Postponing a topic","register":"neutral","unit_ref":null,"romanization":null},{"text":"That seems fair.","context":"Agreeing to a proposal","register":"neutral","unit_ref":null,"romanization":null},{"text":"We have a deal.","context":"Finalising an agreement","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"academic_discussion_b2","level":"B2","situation":"Academic & Formal Discussions","icon":"🎓","phrases":[{"text":"Evidence suggests that...","context":"Presenting evidence","register":"formal","unit_ref":null,"romanization":null},{"text":"According to [source], ...","context":"Citing a source","register":"formal","unit_ref":null,"romanization":null},{"text":"It could be argued that...","context":"Presenting an argument objectively","register":"formal","unit_ref":null,"romanization":null},{"text":"On the other hand, ...","context":"Presenting a contrasting view","register":"formal","unit_ref":null,"romanization":null},{"text":"To a certain extent, ...","context":"Qualified agreement","register":"formal","unit_ref":null,"romanization":null},{"text":"This raises the question of...","context":"Introducing a question","register":"formal","unit_ref":null,"romanization":null},{"text":"There is no denying that...","context":"Stating an undeniable fact","register":"formal","unit_ref":null,"romanization":null},{"text":"The implications of this are significant.","context":"Highlighting consequences","register":"formal","unit_ref":null,"romanization":null},{"text":"In summary, ...","context":"Summarising a point","register":"formal","unit_ref":null,"romanization":null},{"text":"This leads me to conclude that...","context":"Drawing a conclusion","register":"formal","unit_ref":null,"romanization":null}]},{"id":"customer_complaints_b2","level":"B2","situation":"Customer Service & Complaints","icon":"📩","phrases":[{"text":"I'm afraid there seems to be a problem with my order.","context":"Opening a complaint politely","register":"neutral","unit_ref":null,"romanization":null},{"text":"This isn't quite what I ordered.","context":"Politely pointing out an error","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'd like to return this item, please.","context":"Requesting a return","register":"neutral","unit_ref":null,"romanization":null},{"text":"I think I've been overcharged.","context":"Disputing a charge politely","register":"neutral","unit_ref":null,"romanization":null},{"text":"Could I speak to the manager, please?","context":"Escalating a complaint","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'd like a full refund, please.","context":"Requesting a refund","register":"neutral","unit_ref":null,"romanization":null},{"text":"This isn't up to the standard I'd expect.","context":"Expressing dissatisfaction with quality","register":"neutral","unit_ref":null,"romanization":null},{"text":"Could I have a replacement instead?","context":"Asking for a replacement item","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'd like to make a formal complaint.","context":"Initiating a written or official complaint","register":"formal","unit_ref":null,"romanization":null},{"text":"I'm sure we can sort this out.","context":"Collaborative, solution-focused tone","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"social_informal_b2","level":"B2","situation":"Informal Social English","icon":"🍻","phrases":[{"text":"It's good to catch up!","context":"Seeing someone you haven't seen for a while","register":"informal","unit_ref":null,"romanization":null},{"text":"What have you been up to lately?","context":"Casual catching-up question","register":"informal","unit_ref":null,"romanization":null},{"text":"I've been meaning to give you a ring.","context":"'Give someone a ring' = call them — common British expression","register":"informal","unit_ref":null,"romanization":null},{"text":"I know exactly what you mean.","context":"Showing agreement and empathy","register":"informal","unit_ref":null,"romanization":null},{"text":"That's easier said than done.","context":"Pointing out that something is more difficult than it sounds","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'd rather not, if you don't mind.","context":"Polite refusal — very British in its indirectness","register":"neutral","unit_ref":null,"romanization":null},{"text":"It's a bit hit and miss, to be honest.","context":"'Hit and miss' = inconsistent in quality — common British idiom","register":"informal","unit_ref":null,"romanization":null},{"text":"It could have been worse!","context":"British understatement when things went badly but not catastrophically","register":"informal","unit_ref":null,"romanization":null},{"text":"It's nothing to write home about.","context":"British expression meaning something is unremarkable or average","register":"informal","unit_ref":null,"romanization":null},{"text":"Same again?","context":"Offering to buy another round of drinks — essential in British pub culture","register":"informal","unit_ref":null,"romanization":null}]},{"id":"presentations_c1","level":"C1","situation":"Presentations & Public Speaking","icon":"🎤","phrases":[{"text":"Today I'd like to talk to you about...","context":"Opening a presentation","register":"formal","unit_ref":null,"romanization":null},{"text":"I'll begin by outlining the key issues, then move on to...","context":"Signposting the structure","register":"formal","unit_ref":null,"romanization":null},{"text":"As you can see from this slide, ...","context":"Referring to a visual aid","register":"formal","unit_ref":null,"romanization":null},{"text":"I'd like to draw your attention to...","context":"Highlighting an important point","register":"formal","unit_ref":null,"romanization":null},{"text":"Building on this point, ...","context":"Developing an argument","register":"formal","unit_ref":null,"romanization":null},{"text":"This brings me to my next point, which is...","context":"Transitioning between sections","register":"formal","unit_ref":null,"romanization":null},{"text":"What this essentially means is that...","context":"Clarifying a complex idea","register":"formal","unit_ref":null,"romanization":null},{"text":"I'd like to take a step back and consider...","context":"Broadening the perspective","register":"formal","unit_ref":null,"romanization":null},{"text":"The data clearly indicates that...","context":"Interpreting data","register":"formal","unit_ref":null,"romanization":null},{"text":"To put it another way, ...","context":"Rephrasing for clarity","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm happy to take questions at the end.","context":"Managing Q&A","register":"formal","unit_ref":null,"romanization":null},{"text":"That's a very pertinent question.","context":"Acknowledging a good question","register":"formal","unit_ref":null,"romanization":null},{"text":"To summarise the key takeaways, ...","context":"Closing the presentation","register":"formal","unit_ref":null,"romanization":null}]},{"id":"complex_arguments_c1","level":"C1","situation":"Complex Arguments & Critical Thinking","icon":"🧠","phrases":[{"text":"One might argue that..., however the evidence suggests...","context":"Presenting a counterargument then rebutting","register":"formal","unit_ref":null,"romanization":null},{"text":"The distinction between X and Y is crucial here.","context":"Drawing an important distinction","register":"formal","unit_ref":null,"romanization":null},{"text":"While I take your point, I would contend that...","context":"Polite disagreement","register":"formal","unit_ref":null,"romanization":null},{"text":"The issue is more nuanced than it first appears.","context":"Suggesting complexity","register":"formal","unit_ref":null,"romanization":null},{"text":"This argument fails to account for...","context":"Identifying a flaw in reasoning","register":"formal","unit_ref":null,"romanization":null},{"text":"Correlation does not necessarily imply causation.","context":"Questioning a causal claim","register":"formal","unit_ref":null,"romanization":null},{"text":"We should be cautious about generalising from a single case.","context":"Raising methodological concern","register":"formal","unit_ref":null,"romanization":null},{"text":"That notwithstanding, the broader trend is clear.","context":"Acknowledging an exception while maintaining position","register":"formal","unit_ref":null,"romanization":null},{"text":"The weight of evidence points convincingly to...","context":"Summarising evidence","register":"formal","unit_ref":null,"romanization":null},{"text":"I concede that..., but this does not undermine my overall point.","context":"Partial concession","register":"formal","unit_ref":null,"romanization":null},{"text":"What is often overlooked in this debate is...","context":"Introducing a neglected angle","register":"formal","unit_ref":null,"romanization":null},{"text":"The implications of this are far-reaching.","context":"Stressing significance","register":"formal","unit_ref":null,"romanization":null}]},{"id":"professional_networking_c1","level":"C1","situation":"Professional Networking","icon":"🌐","phrases":[{"text":"I believe we have some mutual connections.","context":"Breaking the ice at a professional event","register":"formal","unit_ref":null,"romanization":null},{"text":"I've been following your work on [topic] — it's really compelling.","context":"Opening a conversation with a professional you admire","register":"formal","unit_ref":null,"romanization":null},{"text":"I'd love to pick your brain about [subject] sometime.","context":"Proposing an informal knowledge exchange","register":"neutral","unit_ref":null,"romanization":null},{"text":"Would you be open to a brief call to explore potential synergies?","context":"Suggesting a follow-up meeting","register":"formal","unit_ref":null,"romanization":null},{"text":"I'm currently working on [project] — it might align with what you're doing.","context":"Finding common ground","register":"neutral","unit_ref":null,"romanization":null},{"text":"Could I connect you with [Name]? I think you'd have a lot to discuss.","context":"Making an introduction","register":"formal","unit_ref":null,"romanization":null},{"text":"I'd be happy to share some resources on that if it would be useful.","context":"Offering to help","register":"neutral","unit_ref":null,"romanization":null},{"text":"It was a pleasure speaking with you — let's stay in touch.","context":"Closing a networking conversation","register":"formal","unit_ref":null,"romanization":null},{"text":"I'll send you a LinkedIn request so we can keep the conversation going.","context":"Following up after meeting","register":"neutral","unit_ref":null,"romanization":null},{"text":"Do you have a card, or shall I find you on LinkedIn?","context":"Exchanging contact details","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"conflict_resolution_c1","level":"C1","situation":"Conflict Resolution","icon":"🕊️","phrases":[{"text":"I sense there may be some tension around this issue — shall we address it openly?","context":"Naming a conflict and inviting dialogue","register":"formal","unit_ref":null,"romanization":null},{"text":"I understand this is a difficult situation for all parties involved.","context":"Showing empathy before discussing solutions","register":"formal","unit_ref":null,"romanization":null},{"text":"I'd like to hear your perspective before I share mine.","context":"Demonstrating willingness to listen","register":"neutral","unit_ref":null,"romanization":null},{"text":"I think there may have been a misunderstanding — let me clarify my position.","context":"Addressing a miscommunication","register":"neutral","unit_ref":null,"romanization":null},{"text":"Our goal should be to find a solution that works for everyone.","context":"Refocusing on shared interests","register":"neutral","unit_ref":null,"romanization":null},{"text":"I'm willing to reconsider my stance if you can walk me through your reasoning.","context":"Showing openness to compromise","register":"formal","unit_ref":null,"romanization":null},{"text":"Could we agree to set this point aside for now and return to it later?","context":"De-escalating a heated point","register":"formal","unit_ref":null,"romanization":null},{"text":"I want to be direct without being dismissive of your concerns.","context":"Balancing honesty with respect","register":"neutral","unit_ref":null,"romanization":null},{"text":"What would a satisfactory outcome look like from your perspective?","context":"Inviting the other party to define success","register":"formal","unit_ref":null,"romanization":null},{"text":"I think we're closer to agreement than it might appear.","context":"Building bridges at a tense moment","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"rhetoric_c2","level":"C2","situation":"Rhetoric & Persuasion","icon":"⚖️","phrases":[{"text":"It would be remiss of us not to acknowledge that...","context":"Formally recognising a point","register":"formal","unit_ref":null,"romanization":null},{"text":"The crux of the matter is...","context":"Getting to the heart of the issue","register":"formal","unit_ref":null,"romanization":null},{"text":"Far from being a setback, this represents an opportunity.","context":"Reframing a negative as a positive","register":"formal","unit_ref":null,"romanization":null},{"text":"It stands to reason that...","context":"Presenting something as logical","register":"formal","unit_ref":null,"romanization":null},{"text":"One cannot overstate the importance of...","context":"Emphasising significance","register":"formal","unit_ref":null,"romanization":null},{"text":"The time has come to reconsider our approach.","context":"Calling for change","register":"formal","unit_ref":null,"romanization":null},{"text":"Not only does this fail to address the root cause, but it also...","context":"Compounding criticism","register":"formal","unit_ref":null,"romanization":null},{"text":"This raises the question: why has nothing been done?","context":"Rhetorical challenge — note: 'begs the question' is a common but technically imprecise substitute; in formal academic contexts 'begs the question' means a logical fallacy, not 'raises the question'","register":"formal","unit_ref":null,"romanization":null},{"text":"In the final analysis, ...","context":"Drawing a definitive conclusion","register":"formal","unit_ref":null,"romanization":null},{"text":"We would do well to remember that...","context":"Offering wise counsel","register":"formal","unit_ref":null,"romanization":null},{"text":"There is an inescapable irony in the fact that...","context":"Pointing out contradiction or irony","register":"formal","unit_ref":null,"romanization":null},{"text":"The evidence speaks for itself.","context":"Allowing evidence to make the argument","register":"neutral","unit_ref":null,"romanization":null}]},{"id":"nuanced_discourse_c2","level":"C2","situation":"Nuanced Discourse & Hedging","icon":"🔬","phrases":[{"text":"It is worth noting, albeit with some caution, that...","context":"Careful, hedged observation","register":"formal","unit_ref":null,"romanization":null},{"text":"The picture is, of course, considerably more complex.","context":"Signalling complexity","register":"formal","unit_ref":null,"romanization":null},{"text":"Suffice it to say that...","context":"Indicating something is enough without elaborating","register":"formal","unit_ref":null,"romanization":null},{"text":"This is not to suggest that..., but rather...","context":"Clarifying a potential misinterpretation","register":"formal","unit_ref":null,"romanization":null},{"text":"The extent to which this holds true varies considerably.","context":"Qualifying a generalisation","register":"formal","unit_ref":null,"romanization":null},{"text":"I would be the first to admit that...","context":"Honest concession","register":"formal","unit_ref":null,"romanization":null},{"text":"Taken in isolation, this fact is misleading.","context":"Warning about context","register":"formal","unit_ref":null,"romanization":null},{"text":"There is a fine line between X and Y.","context":"Drawing a subtle distinction","register":"formal","unit_ref":null,"romanization":null},{"text":"The jury is still out on whether...","context":"Saying something is not yet resolved","register":"neutral","unit_ref":null,"romanization":null},{"text":"One is hard-pressed to find a compelling counter-argument.","context":"Strong (but hedged) assertion","register":"formal","unit_ref":null,"romanization":null},{"text":"This warrants further investigation.","context":"Flagging something needs more research","register":"formal","unit_ref":null,"romanization":null},{"text":"At the risk of oversimplifying, ...","context":"Pre-empting a reductionism critique","register":"formal","unit_ref":null,"romanization":null}]},{"id":"legal_contractual_c2","level":"C2","situation":"Legal & Contractual Language","icon":"📜","phrases":[{"text":"The terms set out herein are binding upon both parties.","context":"Formal contract phrasing","register":"formal","unit_ref":null,"romanization":null},{"text":"Notwithstanding the foregoing, ...","context":"Introducing a qualification to a prior statement","register":"formal","unit_ref":null,"romanization":null},{"text":"The party of the first part hereby agrees to...","context":"Initiating a formal obligation","register":"formal","unit_ref":null,"romanization":null},{"text":"This agreement shall be governed by and construed in accordance with the laws of [jurisdiction].","context":"Specifying governing law","register":"formal","unit_ref":null,"romanization":null},{"text":"Any dispute arising out of or in connection with this contract shall be referred to arbitration.","context":"Dispute resolution clause","register":"formal","unit_ref":null,"romanization":null},{"text":"Time is of the essence with respect to delivery.","context":"Stressing deadline importance","register":"formal","unit_ref":null,"romanization":null},{"text":"The licensor grants a non-exclusive, non-transferable licence to use...","context":"Licensing language","register":"formal","unit_ref":null,"romanization":null},{"text":"Either party may terminate this agreement upon [n] days' written notice.","context":"Termination clause","register":"formal","unit_ref":null,"romanization":null},{"text":"This clause shall survive the termination of the agreement.","context":"Survival clause","register":"formal","unit_ref":null,"romanization":null},{"text":"Without prejudice to any other rights or remedies available, ...","context":"Reserving additional rights","register":"formal","unit_ref":null,"romanization":null},{"text":"Force majeure events shall excuse performance obligations.","context":"Addressing unforeseeable circumstances","register":"formal","unit_ref":null,"romanization":null}]},{"id":"social_commentary_c2","level":"C2","situation":"Social Commentary & Debate","icon":"🗞️","phrases":[{"text":"The systemic nature of this problem demands a structural response, not a piecemeal one.","context":"Arguing for root-cause solutions","register":"formal","unit_ref":null,"romanization":null},{"text":"We risk conflating two very different phenomena if we treat them as equivalent.","context":"Warning against false equivalence","register":"formal","unit_ref":null,"romanization":null},{"text":"The dominant narrative obscures more than it reveals.","context":"Challenging mainstream framing","register":"formal","unit_ref":null,"romanization":null},{"text":"There is a troubling tendency to mistake complexity for ambiguity.","context":"Distinguishing nuance from vagueness","register":"formal","unit_ref":null,"romanization":null},{"text":"The discourse around this issue has been, at best, superficial.","context":"Critiquing the quality of public debate","register":"formal","unit_ref":null,"romanization":null},{"text":"What we are witnessing is the logical consequence of decades of policy neglect.","context":"Tracing cause and effect","register":"formal","unit_ref":null,"romanization":null},{"text":"Moral outrage, however justified, is not a substitute for analysis.","context":"Calling for reason over emotion","register":"formal","unit_ref":null,"romanization":null},{"text":"The question is not whether change is needed, but who bears the cost of that change.","context":"Reframing a debate around equity","register":"formal","unit_ref":null,"romanization":null},{"text":"History offers no shortage of cautionary tales on this front.","context":"Invoking historical precedent","register":"formal","unit_ref":null,"romanization":null},{"text":"We should resist the temptation to reduce a multifaceted issue to a single cause.","context":"Opposing oversimplification","register":"formal","unit_ref":null,"romanization":null},{"text":"The stakes could hardly be higher.","context":"Emphasising urgency","register":"formal","unit_ref":null,"romanization":null}]}]